{
  "@context": [
    "https://www.w3.org/2018/credentials/v1",
    "https://raw.githubusercontent.com/pallakartheekreddy/test_project/refs/heads/main/insurance-context.json"
  ],
  "type": [
    "VerifiableCredential",
    "InsuranceCredential"
  ],
  "issuanceDate": "${validFrom}",
  "expirationDate": "${validUntil}",
  "credentialSubject": {
    "fullName": "${fullName}",
    "id": "${id}",
    "dob": "${dob}",
    "email": "${email}",
    "gender": "${gender}",
    "mobile": "${mobile}",
    "policyExpiresOn": "2027-11-18T11:53:00.000Z",
    "policyIssuedOn": "2025-11-18T11:53:00.000Z",
    "policyName": "${policyName}",
    "policyNumber": "${policyNumber}"
  }
}
